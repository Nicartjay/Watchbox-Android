<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Package visibility for the apps we hand links to.

      Android 11+ filters which installed packages an app can see, and that filtering
      applies to `Intent.setPackage` as well as to querying: without a matching <queries>
      entry, naming a package makes the intent unresolvable rather than merely
      unpreferred, and it fails with ActivityNotFoundException even when the app is there.

      Declared narrowly - an ACTION_VIEW filter for http/https, plus YouTube by name -
      rather than QUERY_ALL_PACKAGES, which is a restricted permission and would ask for
      far more visibility than handing off a trailer needs.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.youtube.tv" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Needed only to install our own update APK. Extensions do NOT use this: they
      are loaded from private storage via a classloader, which needs no install
      permission at all. Android still shows its own confirmation prompt for
      every install, so this cannot install anything silently.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Casting. Android's Wi-Fi driver filters multicast frames not addressed to
      the device unless a multicast lock is held, which is exactly the traffic
      SSDP (DLNA) and mDNS (Chromecast) discovery depends on, so without this
      permission discovery silently finds nothing.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Required for Cast discovery on Android 13+. The Cast SDK scans the local
      network for receivers, which counts as deriving nearby-device location, so
      without this the router returns no routes on a modern device.

      neverForLocation tells the system we do not use it to locate the user, which
      avoids the runtime location permission the scan would otherwise imply.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!--
      Lets the app show Android's own "allow background activity" dialog instead of
      sending the user to hunt through system settings.

      Doze suspends network access, which breaks the two things that run while the
      screen is off or the app is backgrounded: the local cast proxy, which must keep
      serving the stream for as long as the receiver plays it, and long playback. The
      failure is a silent stall, so the exemption is worth offering - but it is only
      ever offered, never assumed: the app cannot grant this itself, and the row in
      Settings reports the real system state rather than a preference of our own.

      Note for anyone publishing this on Google Play: this permission is restricted
      there and needs a declared justification, or the upload is rejected. It is
      unrestricted for direct APK distribution, which is how this app ships.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Offline downloads. A multi-gigabyte file cannot be tied to a visible activity, so
      the work runs in a foreground service with a notification that says so.

      DATA_SYNC is the type Android requires for this from API 34; declaring the base
      permission alone is rejected at service start there. POST_NOTIFICATIONS is only
      needed from API 33 - the service itself still runs without it, but its progress
      notification is silently dropped, so the download looks like nothing is happening.

      RECEIVE_BOOT_COMPLETED lets an unfinished queue resume after a restart. Without it
      the queue simply waits until the app is opened again, which is a degradation rather
      than a failure.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:targetApi="34" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Deliberately absent: QUERY_ALL_PACKAGES. Extensions live in this app's
      private storage, so package enumeration is never required.
    -->

    <application
        android:name=".WatchBoxApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WatchBox.Splash"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.WatchBox.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Extension repository links. Repositories advertise themselves as
              `aniyomi://add-repo?url=...`, and the app ships with none, so this is
              the practical way to add one - the alternative is typing a long raw
              URL by hand.

              BROWSABLE is required for links opened from a web page; without it
              only other apps could send them. The activity is singleTask, so a
              link arriving while the app runs is delivered to onNewIntent rather
              than starting a second copy.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aniyomi" android:host="add-repo" />
                <data android:scheme="tachiyomi" android:host="add-repo" />
                <data android:scheme="watchbox" android:host="add-repo" />
            </intent-filter>
        </activity>

        <!--
          The Cast SDK loads this class reflectively by name, so it must also be
          kept by R8. See the cast rules in proguard-rules.pro.
        -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="space.nicart.watchbox.cast.CastOptionsProvider" />

        <!--
          Grants the package installer read access to the downloaded update APK.
          A raw file:// URI would throw FileUriExposedException on API 24+.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Offline downloads. Media3 starts this by name from DownloadService, so R8 has to
          keep it - see the download rules in proguard-rules.pro.

          dataSync is the foreground service type Android requires for a long transfer from
          API 34; the service is refused at start there without it. Not exported: nothing
          outside the app has any business starting a download.
        -->
        <service
            android:name=".download.MediaDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!--
          Resumes an unfinished queue after a reboot, and waits for the network requirement
          to be met. Media3 ships the JobService; it only needs declaring, with the bind
          permission the platform requires of every job.
        -->
        <service
            android:name="androidx.media3.exoplayer.scheduler.PlatformScheduler$PlatformSchedulerService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
